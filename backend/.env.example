# Copy of the settings the backend reads. Do not put real secrets in this file.
# Create your own .env with:   python -m scripts.init_env

# ---- App ----
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# Comma-separated addresses of the frontend(s) allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Matches docker-compose.yml. If you changed the port there, change it here too.
DATABASE_URL=postgresql+asyncpg://eduguide:eduguide@localhost:5432/eduguide
# true prints every SQL query (useful when debugging, noisy otherwise).
DB_ECHO=false

# ---- Auth ----
# At least 32 random characters. `python -m scripts.init_env` fills this in for you.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# How long "child mode" lasts after a parent starts it (720 = 12 hours).
CHILD_SESSION_EXPIRE_MINUTES=720

# ---- Limits ----
MAX_STUDENTS_PER_PARENT=10

# ---- Uploaded books ----
# Folder for uploaded files (relative to backend/). Keep it private: it is never served directly.
STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=600
MAX_DOCUMENTS_PER_BOOK=40
MAX_BOOKS_PER_ACCOUNT=200
# How many books are read at the same time in the background.
PROCESSING_CONCURRENCY=2

# ---- Reading scanned pages (OCR) ----
# none      = scanned pages are skipped (a fully scanned book shows a clear message)
# tesseract = free OCR program; install it first:
#             macOS:  brew install tesseract tesseract-lang
#             Ubuntu: sudo apt install tesseract-ocr tesseract-ocr-hin
OCR_PROVIDER=none
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin

# ---- Tests only ----
# pytest uses a separate database so it can never touch your real data.
# TEST_DATABASE_URL=postgresql+asyncpg://eduguide:eduguide@localhost:5432/eduguide_test
