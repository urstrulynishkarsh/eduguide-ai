# Copy of the settings the backend reads. Do not put real secrets in this file.
# Create your own .env with:   python -m scripts.init_env

# ---- App ----
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# text (easy to read) | json (one JSON object per line, for a log collector; used on servers)
LOG_FORMAT=text
# Prometheus metrics on this port (never the API's own port); 0 = off. infra/monitoring/ reads them.
METRICS_PORT=0
# Comma-separated addresses of the frontend(s) allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Matches docker-compose.yml. If you changed the port there, change it here too.
DATABASE_URL=postgresql+asyncpg://eduguide:eduguide@localhost:5432/eduguide
# true prints every SQL query (useful when debugging, noisy otherwise).
DB_ECHO=false

# ---- Redis: background workers and rate limits ----
# Empty: background jobs (reading books, writing questions...) run inside the API, and rate limits
# are counted in its memory. Fine on one computer.
# Set: jobs go to Redis and `python -m app.worker` runs them (start it next to the API); the limits
# are shared by every API process. Required when ENVIRONMENT=production.
# docker compose up -d starts Redis on this computer:  REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ---- Auth ----
# At least 32 random characters. `python -m scripts.init_env` fills this in for you.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# How long "child mode" lasts after a parent starts it (720 = 12 hours).
CHILD_SESSION_EXPIRE_MINUTES=720

# ---- Limits ----
MAX_STUDENTS_PER_PARENT=10

# ---- Uploaded books ----
# Folder for uploaded files (relative to backend/). Keep it private: it is never served directly.
STORAGE_DIR=storage/uploads
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=600
MAX_DOCUMENTS_PER_BOOK=40
MAX_BOOKS_PER_ACCOUNT=200
# How many books are read at the same time in the background.
PROCESSING_CONCURRENCY=2

# ---- Reading scanned pages (OCR) ----
# none      = scanned pages are skipped (a fully scanned book shows a clear message)
# tesseract = free OCR program; install it first:
#             macOS:  brew install tesseract tesseract-lang
#             Ubuntu: sudo apt install tesseract-ocr tesseract-ocr-hin
OCR_PROVIDER=none
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin

# ---- AI model ----
# none      = AI features (explanations, practice questions, marking written answers) are switched off
# anthropic = Claude; needs ANTHROPIC_API_KEY (from https://platform.claude.com). Paid.
# groq      = open models on Groq; needs GROQ_API_KEY (from https://console.groq.com/keys).
#             Has a free plan with low limits per minute and per day.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Model per tier; leave empty for the provider's choice (Claude: claude-opus-5-5 for all three;
# Groq: openai/gpt-oss-20b for fast, openai/gpt-oss-120b for default and strong).
# Tiers also differ in effort: fast = low, default = medium, strong = high.
LLM_MODEL_FAST=
LLM_MODEL_DEFAULT=
LLM_MODEL_STRONG=

# ---- Search inside books ----
# The multilingual search model (intfloat/multilingual-e5-base, ~1 GB) runs on this computer,
# no key needed. It is downloaded here the first time a book is read.
MODEL_CACHE_DIR=storage/models

# ---- Tests only ----
# pytest uses a separate database so it can never touch your real data.
# TEST_DATABASE_URL=postgresql+asyncpg://eduguide:eduguide@localhost:5432/eduguide_test
# The tests of the Redis parts use database 15 (emptied around each test).
# REDIS_TEST_URL=redis://localhost:6379/15
