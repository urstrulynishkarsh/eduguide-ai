# The server's settings (infra/docker-compose.production.yml). Copy to infra/production.env, which
# git ignores, and fill in every empty value. The other settings are explained in backend/.env.example.

# The web address families open. Its DNS must point at this server before the first start, so Caddy
# can get the HTTPS certificate. (DOMAIN=localhost tries everything on one computer.)
DOMAIN=

# Long random values, e.g.:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET_KEY=

# The browser never calls the API directly, so no other site needs to.
CORS_ORIGINS=

# none | anthropic | groq, and its key
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Scanned pages: Tesseract is in the image.
OCR_PROVIDER=tesseract

# Books read at the same time by each worker.
PROCESSING_CONCURRENCY=2
